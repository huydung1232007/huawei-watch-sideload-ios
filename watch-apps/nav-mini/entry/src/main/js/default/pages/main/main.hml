<div class="container">
    <text class="title">NAV MINI - BAN THU</text>
    <text class="status">{{status}}</text>
    <div class="turn"><text class="arrow">{{arrow}}</text><text class="distance">{{distance}}</text></div>
    <text class="instruction">{{instruction}}</text>
    <text class="summary">{{summary}}</text>
    <text class="footer">{{footer}}</text>
    <div class="button" onclick="request"><text class="label">{{button}}</text></div>
</div>
